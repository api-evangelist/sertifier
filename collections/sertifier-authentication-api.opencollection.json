{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sertifier Credential Attributes Authentication API",
    "version": "3.3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "secretKey",
      "value": "{{secretKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verify API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://b2b.sertifier.com/Test",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ]
          },
          "docs": "Verifies that the provided secretKey is valid."
        }
      ]
    }
  ],
  "bundled": true
}