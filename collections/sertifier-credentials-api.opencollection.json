{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sertifier Credential Attributes Credentials API",
    "version": "3.3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "secretKey",
      "value": "{{secretKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a credential",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://b2b.sertifier.com/credential/:credentialId",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "credentialId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a credential"
        },
        {
          "info": {
            "name": "Update a credential",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://b2b.sertifier.com/credential/:credentialId",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "credentialId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a credential"
        },
        {
          "info": {
            "name": "Delete a credential",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://b2b.sertifier.com/credential/:credentialId",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "credentialId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a credential"
        },
        {
          "info": {
            "name": "Search credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://b2b.sertifier.com/credential/search",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a paginated list of issued credentials matching the filters."
        },
        {
          "info": {
            "name": "Publish credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://b2b.sertifier.com/credential/publish",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Publishes one or more credentials, making their verifiable URLs live."
        },
        {
          "info": {
            "name": "Generate a credential PDF link",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://b2b.sertifier.com/credential/generatePDFLink/:credentialIdOrCertificateNo",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "credentialIdOrCertificateNo",
                "value": "",
                "type": "path",
                "description": "The credential ID or the certificate number."
              }
            ]
          },
          "docs": "Generates a downloadable PDF link for a credential, identified by its credential ID or its certificate number."
        }
      ]
    }
  ],
  "bundled": true
}