        },
        {
          "name": "Copy a design",
          "request": {
            "method": "POST",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"designId\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/design/copy", "host": ["{{baseUrl}}"], "path": ["design", "copy"] },
            "description": "Duplicates an existing design."
          }
        }
      ]
    },
