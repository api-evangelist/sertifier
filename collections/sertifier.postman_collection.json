          "name": "Retrieve a design",
          "request": {
            "method": "GET",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" } ],
            "url": { "raw": "{{baseUrl}}/design/:designId", "host": ["{{baseUrl}}"], "path": ["design", ":designId"], "variable": [ { "key": "designId", "value": "" } ] },
