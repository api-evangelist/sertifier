{
  "info": {
    "name": "Sertifier Credential API",
    "description": "Programmatic design, issuance, verification, and management of digital credentials (certificates and badges) on Sertifier. A credential is issued inside a Campaign that binds a Design, a Detail, and an Email Template, delivered to a Recipient, with custom Attributes merged at issue time. Base URL: https://b2b.sertifier.com. Authenticate with a private API key in the `secretKey` header plus an `api-version` header (3.3). Endpoints and the base host are grounded in Sertifier's public Apiary reference and help-center guides; some request bodies are minimally modeled.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "secretKey", "type": "string" },
      { "key": "value", "value": "{{secretKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://b2b.sertifier.com", "type": "string" },
    { "key": "secretKey", "value": "", "type": "string" },
    { "key": "apiVersion", "value": "3.3", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Verify API key",
          "request": {
            "method": "GET",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" } ],
            "url": { "raw": "{{baseUrl}}/Test", "host": ["{{baseUrl}}"], "path": ["Test"] },
            "description": "Verifies that the provided secretKey is valid."
          }
        }
      ]
    },
    {
      "name": "Campaigns",
      "item": [
        {
          "name": "Create a campaign",
          "request": {
            "method": "POST",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Course Completion\",\n  \"designId\": \"\",\n  \"detailId\": \"\",\n  \"emailTemplateId\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/campaign", "host": ["{{baseUrl}}"], "path": ["campaign"] },
            "description": "Creates a campaign that binds a Design, Detail, and Email Template. Returns the campaignId."
          }
        },
        {
          "name": "Retrieve a campaign",
          "request": {
            "method": "GET",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" } ],
            "url": { "raw": "{{baseUrl}}/campaign/:campaignId", "host": ["{{baseUrl}}"], "path": ["campaign", ":campaignId"], "variable": [ { "key": "campaignId", "value": "" } ] },
            "description": "Retrieves a campaign by ID."
          }
        },
        {
          "name": "Update a campaign",
          "request": {
            "method": "PUT",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/campaign/:campaignId", "host": ["{{baseUrl}}"], "path": ["campaign", ":campaignId"], "variable": [ { "key": "campaignId", "value": "" } ] },
            "description": "Updates a campaign."
          }
        },
        {
          "name": "Delete a campaign",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" } ],
            "url": { "raw": "{{baseUrl}}/campaign/:campaignId", "host": ["{{baseUrl}}"], "path": ["campaign", ":campaignId"], "variable": [ { "key": "campaignId", "value": "" } ] },
            "description": "Deletes a campaign."
          }
        },
        {
          "name": "Search campaigns",
          "request": {
            "method": "POST",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"page\": 1,\n  \"pageSize\": 20\n}" },
            "url": { "raw": "{{baseUrl}}/campaign/search", "host": ["{{baseUrl}}"], "path": ["campaign", "search"] },
            "description": "Returns a paginated list of campaigns."
          }
        },
        {
          "name": "Add / issue credentials",
          "request": {
            "method": "POST",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"campaignId\": \"\",\n  \"credentials\": [\n    {\n      \"name\": \"Jane Doe\",\n      \"email\": \"jane@example.com\",\n      \"quickPublish\": true,\n      \"externalId\": \"enrolment-123\",\n      \"attributes\": [ { \"id\": \"score\", \"value\": \"95\" } ]\n    }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/campaign/addCredentials", "host": ["{{baseUrl}}"], "path": ["campaign", "addCredentials"] },
            "description": "Issues credentials into a campaign. Response includes the permanent, verifiable credential URL. Guard with an idempotency key (enrolment ID + campaignId)."
          }
        },
        {
          "name": "Send / publish a campaign",
          "request": {
            "method": "POST",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"campaignId\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/campaign/send", "host": ["{{baseUrl}}"], "path": ["campaign", "send"] },
            "description": "Publishes a campaign's credentials and sends delivery emails."
          }
        },
        {
          "name": "Schedule credential distribution",
          "request": {
            "method": "POST",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"campaignId\": \"\",\n  \"scheduleDate\": \"2026-08-01T09:00:00Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/campaign/schedule", "host": ["{{baseUrl}}"], "path": ["campaign", "schedule"] },
            "description": "Schedules a campaign's credential distribution at a future UTC time."
          }
        }
      ]
    },
    {
      "name": "Credentials",
      "item": [
        {
          "name": "Retrieve a credential",
          "request": {
            "method": "GET",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" } ],
            "url": { "raw": "{{baseUrl}}/credential/:credentialId", "host": ["{{baseUrl}}"], "path": ["credential", ":credentialId"], "variable": [ { "key": "credentialId", "value": "" } ] },
            "description": "Retrieves an issued credential by ID."
          }
        },
        {
          "name": "Update a credential",
          "request": {
            "method": "PUT",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/credential/:credentialId", "host": ["{{baseUrl}}"], "path": ["credential", ":credentialId"], "variable": [ { "key": "credentialId", "value": "" } ] },
            "description": "Updates an issued credential."
          }
        },
        {
          "name": "Delete a credential",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" } ],
            "url": { "raw": "{{baseUrl}}/credential/:credentialId", "host": ["{{baseUrl}}"], "path": ["credential", ":credentialId"], "variable": [ { "key": "credentialId", "value": "" } ] },
            "description": "Deletes an issued credential."
          }
        },
        {
          "name": "Search credentials",
          "request": {
            "method": "POST",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"page\": 1,\n  \"pageSize\": 20\n}" },
            "url": { "raw": "{{baseUrl}}/credential/search", "host": ["{{baseUrl}}"], "path": ["credential", "search"] },
            "description": "Returns a paginated list of issued credentials."
          }
        },
        {
          "name": "Publish credentials",
          "request": {
            "method": "POST",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"credentialIds\": []\n}" },
            "url": { "raw": "{{baseUrl}}/credential/publish", "host": ["{{baseUrl}}"], "path": ["credential", "publish"] },
            "description": "Publishes credentials, making their verifiable URLs live."
          }
        },
        {
          "name": "Generate credential PDF link",
          "request": {
            "method": "GET",
            "header": [ { "key": "api-version", "value": "{{apiVersion}}" } ],
            "url": { "raw": "{{baseUrl}}/credential/generatePDFLink/:credentialIdOrCertificateNo", "host": ["{{baseUrl}}"], "path": ["credential", "generatePDFLink", ":credentialIdOrCertificateNo"], "variable": [ { "key": "credentialIdOrCertificateNo", "value": "" } ] },
            "description": "Generates a downloadable PDF link for a credential by ID or certificate number."
          }
        }
      ]
    },
    {
      "name": "Designs",
      "item": [
