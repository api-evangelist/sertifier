            "url": { "raw": "{{baseUrl}}/detail/:detailId", "host": ["{{baseUrl}}"], "path": ["detail", ":detailId"], "variable": [ { "key": "detailId", "value": "" } ] },
            "description": "Updates a credential Detail. Details become immutable once credentials are sent."
          }
        },
        {
          "name": "Search details",
          "request": {
            "method": "POST",
