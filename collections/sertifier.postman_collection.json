            "body": { "mode": "raw", "raw": "{\n  \"emailTemplateId\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/emailTemplate/copy", "host": ["{{baseUrl}}"], "path": ["emailTemplate", "copy"] },
            "description": "Duplicates an existing email template."
          }
        }
      ]
    },
    {
